
<https://w3id.org/dsanno/platform/pattern/manifestation/sweep/segments/context> {
  <https://w3id.org/dsanno/platform/pattern/manifestation/sweep/segments> a <http://www.researchspace.org/resource/system/fields/Field>,
      <http://www.w3.org/ns/prov#Entity>, <http://www.w3.org/ns/ldp#Resource>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Placement sweep (hidden, delete-time hygiene)";
    <http://www.w3.org/2000/01/rdf-schema#comment> "MR-55. Carries no user-visible value. Its selectPattern returns the manifestation itself as a sentinel iff anything is placed in it; its deletePattern removes every container segment under it, the range-designation subtree, both shortcut pairs and any bare placement edge, in one UPDATE. insertPattern is deliberately empty: this field never writes.";
    <http://www.researchspace.org/resource/system/fields/domain> <http://iflastandards.info/ns/lrm/lrmoo/F3_Manifestation>;
    <http://www.researchspace.org/resource/system/fields/range> <http://iflastandards.info/ns/lrm/lrmoo/F3_Manifestation>;
    <http://www.researchspace.org/resource/system/fields/minOccurs> "0";
    <http://www.researchspace.org/resource/system/fields/maxOccurs> "1";
    <http://www.researchspace.org/resource/system/fields/xsdDatatype> <http://www.w3.org/2001/XMLSchema#anyURI>;
    <http://www.researchspace.org/resource/system/fields/selectPattern> _:node1k26mt6dax856;
    <http://www.researchspace.org/resource/system/fields/insertPattern> _:node1k26mt6dax857;
    <http://www.researchspace.org/resource/system/fields/deletePattern> _:node1k26mt6dax858;
    <http://www.w3.org/ns/prov#wasAttributedTo> <http://www.researchspace.org/resource/user/admin>;
    <http://www.w3.org/ns/prov#generatedAtTime> "2026-09-11T11:12:14.439+02:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
  
  _:node1k26mt6dax856 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """SELECT DISTINCT ?value WHERE {
  {
    $subject crm:P106_is_composed_of ?anySegment .
    ?anySegment crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> .
  } UNION {
    ?anyHolder lrmoo:R4i_is_embodied_in $subject .
  } UNION {
    ?anyBare crm:P106i_forms_part_of $subject .
  }
  BIND($subject AS ?value)
}""" .
  
  _:node1k26mt6dax857 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """INSERT {
  $subject <https://w3id.org/dsanno/platform/pattern/manifestation/sweep/segments/never> $value .
} WHERE {
  FILTER(false)
}""" .
  
  _:node1k26mt6dax858 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """DELETE {
  # every triple into and out of the segment subtree
  ?node     ?outP ?outO .
  ?inS      ?inP  ?node .
  # the R4/R4i shortcut pair
  ?holder   lrmoo:R4i_is_embodied_in $subject .
  $subject  lrmoo:R4_embodies        ?holder .
  # the P106/P106i pair: materialised shortcut or hand-typed bare placement
  ?bare     crm:P106i_forms_part_of  $subject .
  $subject  crm:P106_is_composed_of  ?bare .
} WHERE {
  {
    # (1) the container-segment subtree under $subject: segment, range designation, bounds.
    #     No BIND() inside a UNION branch: Blazegraph does not treat a BIND-assigned
    #     variable as a join variable and degenerates into a full scan (measured on dev:
    #     4 064 spurious ?node bindings against 8 real ones).
    {
      $subject crm:P106_is_composed_of ?node .
      ?node crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> .
    } UNION {
      $subject crm:P106_is_composed_of ?segment .
      ?segment crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> .
      ?segment crm:P1_is_identified_by ?node .
      ?node crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Range_Designation> .
    } UNION {
      $subject crm:P106_is_composed_of ?segment2 .
      ?segment2 crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> .
      ?segment2 crm:P1_is_identified_by ?rangeDesignation .
      ?rangeDesignation crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Range_Designation> .
      ?rangeDesignation crm:P106_is_composed_of ?node .
    }
    { ?node ?outP ?outO } UNION { ?inS ?inP ?node }
  }
  # (2) both legs of each shortcut pair, matched independently so one-legged residue
  #     is swept too. Unbound template triples are dropped per SPARQL 1.1 §4.1.3,
  #     which is what lets these branches share one DELETE template.
  UNION { ?holder lrmoo:R4i_is_embodied_in $subject . }
  UNION { $subject lrmoo:R4_embodies ?holder . }
  UNION { ?bare crm:P106i_forms_part_of $subject . }
  UNION { $subject crm:P106_is_composed_of ?bare . }
}""" .
  
  <http://www.researchspace.org/resource/system/fieldDefinitionContainer> <http://www.w3.org/ns/ldp#contains>
      <https://w3id.org/dsanno/platform/pattern/manifestation/sweep/segments> .
}
