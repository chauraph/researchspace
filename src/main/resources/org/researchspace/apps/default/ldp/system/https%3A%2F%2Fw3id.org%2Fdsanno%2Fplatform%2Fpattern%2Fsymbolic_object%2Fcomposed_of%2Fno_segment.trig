  _:node1k28dunb9x1103 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """INSERT { 
	$subject crm:P106_is_composed_of $value . 
    $value crm:P106i_forms_part_of $subject .
} WHERE {}""" .
  
  _:node1k28dunb9x1104 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """SELECT DISTINCT ?value ?label WHERE {
	$subject crm:P106_is_composed_of $value . 
      
    ?value a ?ontologyClass .
    ?ontologyClass rdfs:subClassOf* crm:E90_Symbolic_Object .
    FILTER NOT EXISTS { ?value crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> }
    { 
      ?value crm:P1_is_identified_by ?appellation .
      ?appellation a crm:E41_Appellation .
      ?appellation crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/primary_appellation> . 
      ?appellation crm:P190_has_symbolic_content ?label .
    } UNION {
      ?value crm:P190_has_symbolic_content ?label .
    }
}""" .
  
  _:node1k28dunb9x1105 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """DELETE {
	$subject crm:P106_is_composed_of $value . 
    $value crm:P106i_forms_part_of $subject .
} WHERE {
	$subject crm:P106_is_composed_of $value . 
    $value crm:P106i_forms_part_of $subject .
      
    ?value a ?ontologyClass .
    ?ontologyClass rdfs:subClassOf* crm:E90_Symbolic_Object .
    { 
      ?value crm:P1_is_identified_by ?appellation .
      ?appellation a crm:E41_Appellation .
      ?appellation crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/primary_appellation> . 
      ?appellation crm:P190_has_symbolic_content ?label .
    } UNION {
      ?value crm:P190_has_symbolic_content ?label .
    }
}""" .
  
  _:node1k28dunb9x1106 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """SELECT DISTINCT ?value ?label WHERE {
    ?value a ?ontologyClass .
    ?ontologyClass rdfs:subClassOf* crm:E90_Symbolic_Object .
    FILTER NOT EXISTS { ?value crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> }
    { 
      ?value crm:P1_is_identified_by ?appellation .
      ?appellation a crm:E41_Appellation .
      ?appellation crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/primary_appellation> . 
      ?appellation crm:P190_has_symbolic_content ?label .
    } UNION {
      ?value crm:P190_has_symbolic_content ?label .
    }

  MINUS { ?value crm:P71i_is_listed_in|skos:inScheme ?systemAuthority . ?systemAuthority crm:P2_has_type Platform:System_Resource . }
  MINUS { ?systemAuthorityTerm crm:P1_is_identified_by ?value .
          ?systemAuthorityTerm crm:P71i_is_listed_in|skos:inScheme ?systemAuthorityDoc .
          ?systemAuthorityDoc crm:P2_has_type Platform:System_Resource .
        }
  FILTER REGEX(LCASE(STR(?label)), \"?token\", \"i\")
} ORDER BY ASC(?label)
  LIMIT 10""" .
  
  <http://www.researchspace.org/resource/system/fieldDefinitionContainer> <http://www.w3.org/ns/ldp#contains>
      <https://w3id.org/dsanno/platform/pattern/symbolic_object/composed_of/no_segment> .
}
