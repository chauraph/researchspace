  _:genid-dsanno-image-file-identifier-optional-r6z7l8 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """DELETE { 
  $subject crmdig:L60i_is_documented_by ?digitizationProcess .
  ?digitizationProcess a crmdig:D2_Digitization_Process .    
  ?digitizationProcess crmdig:L11_had_output $value . 
} WHERE { 
  $subject crmdig:L60i_is_documented_by ?digitizationProcess .
  ?digitizationProcess a crmdig:D2_Digitization_Process .    
  ?digitizationProcess crmdig:L11_had_output $value . 
      
  ?value a rs:EX_File .
}""" .
  
  _:genid-dsanno-image-file-identifier-optional-bg0sr a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """INSERT { 
  $subject crmdig:L60i_is_documented_by ?digitizationProcess .
  ?digitizationProcess a crmdig:D2_Digitization_Process .    
  ?digitizationProcess crmdig:L11_had_output $value . 
} WHERE {
	BIND(URI(CONCAT(str($subject),\"/digitization_process\")) as ?digitizationProcess)
}""" .
  
  _:genid-dsanno-image-file-identifier-optional-ky9l5tf a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """SELECT DISTINCT ?value WHERE {
  $subject crmdig:L60i_is_documented_by ?digitizationProcess .
  ?digitizationProcess a crmdig:D2_Digitization_Process .    
  ?digitizationProcess crmdig:L11_had_output $value . 
      
  ?value a rs:EX_File .
}""" .
  
