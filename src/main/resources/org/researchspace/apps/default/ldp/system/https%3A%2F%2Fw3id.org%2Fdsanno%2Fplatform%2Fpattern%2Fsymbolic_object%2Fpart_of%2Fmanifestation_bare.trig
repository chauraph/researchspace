  _:node1k28dunb9x1095 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """INSERT {
  $subject crm:P106i_forms_part_of $value .
  $value crm:P106_is_composed_of $subject .
} WHERE {}""" .
  
  _:node1k28dunb9x1096 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """SELECT DISTINCT ?value ?label WHERE {
  $subject crm:P106i_forms_part_of ?value .
  ?value rdf:type lrmoo:F3_Manifestation .
  OPTIONAL {
    ?value crm:P1_is_identified_by ?appellation .
    ?appellation crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/primary_appellation> ;
                 crm:P190_has_symbolic_content ?label .
  }
}""" .
  
  _:node1k28dunb9x1097 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """DELETE {
  $subject crm:P106i_forms_part_of $value .
  $value   crm:P106_is_composed_of $subject .
} WHERE {
  $subject crm:P106i_forms_part_of $value .
  $value   crm:P106_is_composed_of $subject .
  # L3 (subclass-reach 6.2): no rdf:type gate here — insert is ungated, so delete
  # must be able to retract exactly what insert wrote.
  # keep the link if it is the materialised shortcut of a live container segment
  FILTER NOT EXISTS {
    $subject crm:P106i_forms_part_of ?seg .
    ?seg crm:P2_has_type <https://w3id.org/dsanno/ontology/sourcing/Container_Segment> .
    ?seg crm:P106i_forms_part_of $value .
  }
}""" .
  
  _:node1k28dunb9x1098 a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """SELECT DISTINCT ?value ?label WHERE {
  ?value rdf:type lrmoo:F3_Manifestation .
  {
    ?value crm:P1_is_identified_by ?appellation .
    ?appellation crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/primary_appellation> ;
                 crm:P190_has_symbolic_content ?label .
  } UNION {
    ?value crm:P190_has_symbolic_content ?label .
  }
  MINUS { ?value crm:P71i_is_listed_in|skos:inScheme ?systemAuthority .
          ?systemAuthority crm:P2_has_type Platform:System_Resource . }
  FILTER REGEX(LCASE(STR(?label)), \"?token\", \"i\")
} ORDER BY ASC(?label)
  LIMIT 10""" .
  
  <http://www.researchspace.org/resource/system/fieldDefinitionContainer> <http://www.w3.org/ns/ldp#contains>
      <https://w3id.org/dsanno/platform/pattern/symbolic_object/part_of/manifestation_bare> .
}
