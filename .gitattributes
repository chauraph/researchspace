#
# https://help.github.com/articles/dealing-with-line-endings/
#
# These are explicitly windows files and should use crlf
*.bat           text eol=crlf

# Mirador bundle: generated by src/main/web/lib/mirador-src/build.mjs.
# -text so a CRLF checkout cannot corrupt it, merge=binary so git never attempts
# a textual auto-merge on a 149k-line generated file (take ours, then rebuild).
src/main/web/lib/mirador/mirador.js       -text -diff linguist-generated merge=binary
src/main/web/lib/mirador-src/vendors/*.js -text -diff linguist-generated

